# Copy to site/.env.local (gitignored). Only DATABASE_URL is needed to run most pages locally.
# Read-only Postgres login (manta_site); a local Postgres with db/schema.sql works.
DATABASE_URL=postgresql://manta_site@localhost:5432/manta
# Waitlist sign-up (insert-only login) and accounts (row-level security login).
SIGNUP_DATABASE_URL=
ACCOUNT_DATABASE_URL=
# Sign-in (Clerk). Without these, account pages won't work.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Replay server on the VM (recorder/cmd/replayserve); /replay needs it.
REPLAY_URL=
REPLAY_TOKEN=
