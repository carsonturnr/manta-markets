{
  "permissions": {
    "ask": [
      "Bash(psql:*)",
      "Bash(supabase db:*)",
      "Bash(supabase migration:*)",
      "Edit(db/**)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(infra/deploy/*)",
      "Bash(./infra/deploy/*)",
      "Bash(bash infra/deploy/*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh"
          }
        ]
      }
    ]
  }
}
