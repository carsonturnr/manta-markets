# Manta tracker snapshot: Kalshi prices and our fair values to Postgres (docs/milestone-3-tracker.md).
[Unit]
Description=Manta tracker snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=manta
EnvironmentFile=/etc/manta/env
# DATABASE_URL: the local Postgres as manta_job (infra/deploy/db/setup.md); read last, so it wins.
EnvironmentFile=/etc/manta/db.env
ExecStart=/opt/manta/pricing/.venv/bin/manta-snap
# Under a minute, so a slow run never overlaps the next one; a timed-out run is a missing minute.
TimeoutStartSec=50
