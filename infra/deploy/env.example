# /etc/manta/env on the VM (deploy.sh creates it; the Kalshi key ID is appended from the old Series env).
KALSHI_PRIVATE_KEY_PATH=/etc/manta/kalshi.pem
STORAGEBOX_USER=<storagebox-user>
# Days of raw files kept on the VM after archiving (about 6.7 GB/day; the disk has about 21 GB free).
KEEP_DAYS=1
