# Copy to .env (gitignored). Read by the pricing jobs (`uv run --env-file ../.env ...`) and the
# recorder. Everything is optional for running tests; the recorder runs without Kalshi keys
# (it polls Kalshi's public REST API instead of the WebSocket).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Admin Postgres URL (a local Postgres works: createdb manta, then `uv run manta-snap --init`).
DATABASE_URL=postgresql://localhost:5432/manta
# Passwords set for the site's read-only, waitlist and account logins by `manta-snap --init --passwords`.
SITE_DB_PASSWORD=
SIGNUP_DB_PASSWORD=
ACCOUNT_DB_PASSWORD=
# Alerts (pricing/alerts.py): Clerk to look up a user's email, Resend to send it.
CLERK_SECRET_KEY=
RESEND_API_KEY=
# Shared secrets between the VM's replay/relay servers and the site.
REPLAY_TOKEN=
RELAY_TOKEN=
